{
  "name": "@pathloom/canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pathloom whiteboard + roadmap canvas (Canvas2D, no React)",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist/types",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.2",
    "rbush": "^4.0.1",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/rbush": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
