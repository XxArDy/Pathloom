{
  "stages": [
    {
      "id": "AUDIENCE",
      "title": "Аудиторія та результати",
      "description": "Для кого курс і що вони зможуть після нього.",
      "who": "me",
      "tasks": [
        "Описати ідеального студента та його початковий рівень",
        "Сформулювати 3-5 конкретних результатів навчання",
        "Подивитися, що вже покривають схожі курси",
        "Визначити формат, тривалість і ціновий діапазон"
      ]
    },
    {
      "id": "SYLLABUS",
      "title": "Програма та план уроків",
      "description": "Структура модулів і уроків, що веде до результатів.",
      "who": "both",
      "depends": [
        "AUDIENCE"
      ],
      "tasks": [
        "Розбити результати на модулі",
        "Скласти список уроків із метою кожного",
        "Впорядкувати уроки від простого до складного",
        "Оцінити час на кожен урок"
      ]
    },
    {
      "id": "LESSONS",
      "title": "Створення уроків",
      "description": "Записати або написати власне навчальний матеріал.",
      "who": "both",
      "depends": [
        "SYLLABUS"
      ],
      "tasks": [
        "Написати сценарії чи слайди модуля 1",
        "Записати або написати модуль 1",
        "Створити решту модулів",
        "Додати приклади та матеріали для завантаження",
        "Переглянути всі уроки на узгодженість"
      ]
    },
    {
      "id": "PRACTICE",
      "title": "Вправи та оцінювання",
      "description": "Практика, яка доводить, що результатів досягнуто.",
      "who": "both",
      "depends": [
        "SYLLABUS"
      ],
      "tasks": [
        "Придумати вправу до кожного модуля",
        "Написати тести з відповідями",
        "Підготувати фінальний проєкт",
        "Написати інструкцію з оцінювання чи самоперевірки"
      ]
    },
    {
      "id": "PLATFORM",
      "title": "Платформа та сторінка курсу",
      "description": "Де студенти знаходять, купують і проходять курс.",
      "who": "both",
      "depends": [
        "SYLLABUS"
      ],
      "tasks": [
        "Обрати платформу",
        "Налаштувати структуру курсу й оплату",
        "Написати сторінку курсу та опис програми",
        "Підготувати вітальні повідомлення й підтримку"
      ]
    },
    {
      "id": "PILOT",
      "title": "Пілот із першими студентами",
      "description": "Провести курс із малою групою до відкриття для всіх.",
      "who": "me",
      "depends": [
        "LESSONS",
        "PRACTICE",
        "PLATFORM"
      ],
      "tasks": [
        "Запросити 5-10 пілотних студентів",
        "Збирати відгуки після кожного модуля",
        "Відстежувати, де студенти застрягають",
        "Попросити відгуки для сторінки курсу"
      ]
    },
    {
      "id": "IMPROVE",
      "title": "Покращення за відгуками",
      "description": "Виправити те, що показав пілот.",
      "who": "both",
      "depends": [
        "PILOT"
      ],
      "tasks": [
        "Скласти список проблем за важливістю",
        "Переробити незрозумілі уроки",
        "Виправити вправи й тести",
        "Оновити сторінку курсу за результатами"
      ]
    },
    {
      "id": "OPEN",
      "title": "Відкриття набору",
      "description": "Курс доступний усім.",
      "kind": "milestone",
      "who": "me",
      "depends": [
        "IMPROVE"
      ],
      "tasks": [
        "Оголосити аудиторії",
        "Налаштувати канал підтримки",
        "Стежити за запитаннями першого тижня",
        "Спланувати наступне оновлення"
      ]
    }
  ],
  "frames": [
    {
      "name": "Проєктування",
      "members": [
        "AUDIENCE",
        "SYLLABUS"
      ]
    },
    {
